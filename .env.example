# Everything below is optional -- docker-compose.yml already has a working
# default for every one of these. Only uncomment/set what you actually want
# to override.

# MongoDB
# MONGODB_URI=mongodb://mongodb:27017/maya_deception

# Backend
# PORT=3001
# JWT_SECRET=dev-secret-change-in-production
# NODE_ENV=development
# SIMULATION_MODE=true
# CRDT_SYNC_INTERVAL=10000

# Restricts which origins may call the API. Left unset, the backend allows
# any origin (reflected, not wildcarded) so the dashboard works out of the
# box from localhost, a LAN IP, or any other device. Uncomment to lock it
# down to specific origins instead (comma-separated).
# CORS_ORIGINS=http://localhost:3000

# Optional: enables LLM-generated decoy company blueprints. Without this,
# decoy generation still works, using a deterministic generator instead.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Frontend (server-side only -- browser code resolves the backend address
# automatically from whatever host it was loaded from, see frontend/lib/api-base.ts)
# NEXT_PUBLIC_API_URL=http://backend:3001
